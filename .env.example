# ==============================================================================
# JURISIVA AI — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# Application Environment (development, staging, production)
APP_ENV=development
APP_NAME="Jurisiva AI"
PORT=8000
HOST=127.0.0.1

# Security & Authentication
JWT_SECRET=super-secret-production-key-32-chars-minimum-hash
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# Database Connection (PostgreSQL + pgvector)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/legal_db

# Cache & Message Queue (Redis)
REDIS_URL=redis://localhost:6379/0

# Object Storage (MinIO / AWS S3)
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_BUCKET=legal-documents
OBJECT_STORAGE_ACCESS_KEY=minioadmin
OBJECT_STORAGE_SECRET_KEY=minioadmin

# AI Model Gateway & Providers
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OPENAI_API_KEY=your-openai-api-key-here
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Indic OCR Engine Settings
OCR_ENGINE=tesseract
SUPPORTED_INDIC_LANGUAGES=en,hi,mr,kn,ta,te,gu,bn,pa
