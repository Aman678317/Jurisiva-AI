# =============================================================================
# JURISIVA-AI PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# NEVER commit production secrets, private keys, or API tokens to GitHub.
# =============================================================================

# 1. Environment & Network
ENVIRONMENT=production
PYTHON_VERSION=3.11.9
PORT=8000
CORS_ORIGINS=https://app.jurisiva.ai,https://www.jurisiva.ai,https://jurisiva-ai.vercel.app,http://localhost:3000

# 2. Vercel Frontend Configuration (Browser-Safe Public Variables)
NEXT_PUBLIC_API_URL=https://api.jurisiva.ai
NEXT_PUBLIC_SUPABASE_URL=https://pyykvqcujfxnxyxtyrjz.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-public-anon-key

# 3. Supabase PostgreSQL, Auth & Storage (Backend Privileged Access)
SUPABASE_URL=https://pyykvqcujfxnxyxtyrjz.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# Shared Transaction-Mode Pooler (Port 6543 for High-Throughput App API & Worker)
DATABASE_URL=postgresql://postgres.pyykvqcujfxnxyxtyrjz:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true
SUPABASE_DB_URL=postgresql://postgres.pyykvqcujfxnxyxtyrjz:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true

# Shared Session-Mode Pooler (Port 5432 for Migrations & DDL)
DIRECT_URL=postgresql://postgres.pyykvqcujfxnxyxtyrjz:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# 4. Redis Job Queue (Render Key-Value Store)
REDIS_URL=rediss://default:your-redis-password@your-redis-host:6379

# 5. Multi-Model AI Router & Key Failover Mesh (Backend / Worker Only)
# Support single key or comma-separated keys for auto-rotation on rate limits (429/quota):

# NVIDIA NIM Provider (Nemotron, Llama-3.1-70B/405B, DeepSeek-R1)
NVIDIA_API_KEY=nvapi-your-primary-nvidia-key
NVIDIA_API_KEYS=nvapi-key1,nvapi-key2,nvapi-key3
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# DeepSeek Provider (DeepSeek-R1 Reasoner & DeepSeek-V3 Chat)
DEEPSEEK_API_KEY=sk-your-primary-deepseek-key
DEEPSEEK_API_KEYS=sk-deepseek-1,sk-deepseek-2
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# GLM / Zhipu AI Provider (GLM-4, GLM-4-Plus, GLM-4-Flash, GLM-2)
GLM_API_KEY=your-primary-glm-zhipu-key
GLM_API_KEYS=glm-key1,glm-key2
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# Frontier Providers (OpenAI / Anthropic / Google)
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_API_KEYS=sk-openai-1,sk-openai-2
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key
ANTHROPIC_API_KEYS=sk-ant-1,sk-ant-2
GOOGLE_API_KEY=AIza-your-google-cloud-api-key
GOOGLE_API_KEYS=AIza-key1,AIza-key2

# 6. OCR & Document Restoration Providers
OCR_PROVIDER=GOOGLE_VISION_AND_TESSERACT
OCR_API_KEY=your-ocr-provider-key

# 7. Web & Apex Legal Research Providers
SEARCH_PROVIDER=APEX_LEGAL_AND_WEB
SEARCH_API_KEY=your-search-provider-key

# 8. Speech-To-Text & Text-To-Speech Providers
STT_PROVIDER=WHISPER_AND_GOOGLE
STT_API_KEY=your-stt-provider-key
TTS_PROVIDER=GOOGLE_NEURAL2
TTS_API_KEY=your-tts-provider-key
